@page "/INSERT"
@using MySql.Data.MySqlClient;

<style>
    body {
        margin: 0;
        padding: 0;
        font-family: Arial, sans-serif;
        background: linear-gradient(135deg, #fff8f0, #ffe8d6);
    }

    .register-page {
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 30px;
    }

    .register-card {
        width: 100%;
        max-width: 500px;
        background: white;
        border-radius: 25px;
        box-shadow: 0 15px 40px rgba(0,0,0,0.15);
        overflow: hidden;
    }

    .register-header {
        background: linear-gradient(135deg, #ff7b54, #ffb26b);
        color: white;
        text-align: center;
        padding: 35px 20px;
    }

        .register-header h1 {
            margin: 0;
            font-size: 36px;
        }

        .register-header p {
            margin-top: 10px;
            font-size: 16px;
        }

    .register-body {
        padding: 35px 30px;
    }

    .form-group {
        margin-bottom: 20px;
    }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            font-size: 16px;
            font-weight: bold;
            color: #444;
        }

        .form-group input {
            width: 100%;
            padding: 14px;
            border: 2px solid #f3d2c1;
            border-radius: 14px;
            font-size: 15px;
            background-color: #fffaf7;
            box-sizing: border-box;
        }

    .register-btn {
        width: 100%;
        padding: 15px;
        border: none;
        border-radius: 14px;
        background: linear-gradient(135deg, #ff7b54, #ff914d);
        color: white;
        font-size: 18px;
        font-weight: bold;
        cursor: pointer;
        margin-top: 10px;
    }

    .home-btn {
        display: block;
        width: 100%;
        margin-top: 15px;
        padding: 15px;
        text-align: center;
        text-decoration: none;
        border-radius: 14px;
        background: linear-gradient(135deg, #444, #777);
        color: white;
        font-size: 18px;
        font-weight: bold;
        box-sizing: border-box;
    }

        .home-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.25);
        }

    .user-icon {
        font-size: 42px;
        margin-bottom: 10px;
    }
</style>

<div class="register-page">
    <div class="register-card">
        <div class="register-header">
            <div class="user-icon">👤</div>
            <h1>Insert User</h1>
            <p>Add a new user to the database</p>
        </div>

        <div class="register-body">

            <div class="form-group">
                <label>User Name</label>
                <input type="text" @bind="userName" placeholder="Enter your name" />
            </div>

            <div class="form-group">
                <label>Password</label>
                <input type="text" @bind="userPassword" placeholder="Enter your password" />
            </div>

            <div class="form-group">
                <label>Email</label>
                <input type="text" @bind="userEmail" placeholder="Enter your email" />
            </div>

            <div class="form-group">
                <label>Nickname</label>
                <input type="text" @bind="usernickName" placeholder="Enter your nickname" />
            </div>

            <button class="register-btn" @onclick="INSERT">Submit</button>

            <a href="/HomeRepice" class="home-btn">Back To Home</a>
            <div class="bottom-text">
                @msg
            </div>

        </div>
        
    </div>
</div>

@code
{
    string userName = "";
    string userEmail = "";
    string usernickName = "";
    string userPassword;
    string msg = "";

    void INSERT()
    {
        MySqlConnection con = new MySqlConnection();
        con.ConnectionString = "server=localhost;user id=root;password=josh17rog;database=yakir_trading_app";
        con.Open();

        string sql = $"INSERT INTO `yakir_trading_app`.`users` (`userName`, `userPasswordl`, `userEmail`, `nickName`) VALUES ('{userName}', '{userPassword}', '{userEmail}', '{usernickName}');";

        MySqlCommand cmd = new MySqlCommand();
        cmd.Connection = con;
        cmd.CommandText = sql;

        int x = cmd.ExecuteNonQuery();

        if (x > 0)
        {
            msg = "User Inserted Successfully";
        }
        else
        {
            msg = "Data Not Inserted";
        }

        con.Close();
    }
}