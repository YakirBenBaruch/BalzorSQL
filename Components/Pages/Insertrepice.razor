@page "/InsertRepice"
@using MySql.Data.MySqlClient;

<style>
    body {
        margin: 0;
        padding: 0;
        font-family: Arial, sans-serif;
        background: linear-gradient(135deg, #fff8f0, #ffe8d6);
    }

    .register-page {
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 30px;
    }

    .register-card {
        width: 100%;
        max-width: 500px;
        background: white;
        border-radius: 25px;
        box-shadow: 0 15px 40px rgba(0,0,0,0.15);
        overflow: hidden;
    }

    .register-header {
        background: linear-gradient(135deg, #ff7b54, #ffb26b);
        color: white;
        text-align: center;
        padding: 35px 20px;
    }

        .register-header h1 {
            margin: 0;
            font-size: 36px;
        }

        .register-header p {
            margin-top: 10px;
            font-size: 16px;
        }

    .register-body {
        padding: 35px 30px;
    }

    .form-group {
        margin-bottom: 20px;
    }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            font-size: 16px;
            font-weight: bold;
            color: #444;
        }

        .form-group input {
            width: 100%;
            padding: 14px;
            border: 2px solid #f3d2c1;
            border-radius: 14px;
            font-size: 15px;
            background-color: #fffaf7;
            box-sizing: border-box;
        }

    .register-btn {
        width: 100%;
        padding: 15px;
        border: none;
        border-radius: 14px;
        background: linear-gradient(135deg, #ff7b54, #ff914d);
        color: white;
        font-size: 18px;
        font-weight: bold;
        cursor: pointer;
        margin-top: 10px;
    }

    .bottom-text {
        text-align: center;
        margin-top: 18px;
        color: #777;
        font-size: 14px;
    }

    .food-icon {
        font-size: 42px;
        margin-bottom: 10px;
    }
</style>

<div class="register-page">
    <div class="register-card">
        <div class="register-header">
            <div class="food-icon">🍲</div>
            <h1>Insert Recipe</h1>
            <p>Add a new delicious recipe to your collection</p>
        </div>

        <div class="register-body">

            <div class="form-group">
                <label>Name Of Recipe</label>
                <input type="text" @bind="nameOfRepice" placeholder="Enter recipe name" />
            </div>

            <div class="form-group">
                <label>Groceries</label>
                <input type="text" @bind="groceries" placeholder="Enter groceries" />
            </div>

            <div class="form-group">
                <label>Preparation Process</label>
                <input type="text" @bind="preparationProcess" placeholder="Enter preparation process" />
            </div>

            <div class="form-group">
                <label>Perparation Tools</label>
                <input type="text" @bind="perparationTools" placeholder="Enter preparation tools" />
            </div>

            <div class="form-group">
                <label>Recipecol</label>
                <input type="text" @bind="recipecol" placeholder="Enter recipecol" />
            </div>

            <button class="register-btn" @onclick="insertrepice">Insert Recipe</button>

            <div class="bottom-text">
                Save your favorite recipe and keep building your cookbook
            </div>
        </div>
    </div>
</div>

@code
{
    string nameOfRepice;
    string groceries;
    string preparationProcess;
    string perparationTools;
    string recipecol;

    void insertrepice()
    {
        MySqlConnection con = new MySqlConnection();
        con.ConnectionString = "server=localhost;user id=root;password=josh17rog;database=yakir_trading_app";
        con.Open();

        string sql = $"INSERT INTO `yakir_trading_app`.`recipe` " +
                     $"(`Name Of Recipe`, `Groceries`, `Preparation Process`, `Perparation Tools`, `Recipecol`) " +
                     $"VALUES ('{nameOfRepice}', '{groceries}', '{preparationProcess}', '{perparationTools}', '{recipecol}');";

        MySqlCommand cmd = new MySqlCommand();
        cmd.Connection = con;
        cmd.CommandText = sql;

        int x = cmd.ExecuteNonQuery();

        if (x > 0)
        {
            Console.WriteLine("Data Inserted");
        }
        else
        {
            Console.WriteLine("Error");
        }

        con.Close();
    }
}