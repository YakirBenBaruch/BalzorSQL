@page "/Update"
@using MySql.Data.MySqlClient;

<style>
    :root {
        --bg1: #0f172a;
        --bg2: #020617;
        --card: rgba(15,23,42,.85);
        --border: rgba(148,163,184,.25);
        --text: #e2e8f0;
        --muted: rgba(226,232,240,.6);
        --primary: #3b82f6;
        --primary-dark: #1d4ed8;
        --shadow: 0 25px 70px rgba(0,0,0,.55);
    }

    html, body {
        height: 100%;
    }

    body {
        margin: 0;
        font-family: system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif;
        background: radial-gradient(1200px 600px at 20% 10%, rgba(59,130,246,.15), transparent 60%), radial-gradient(1000px 500px at 85% 20%, rgba(29,78,216,.12), transparent 55%), linear-gradient(180deg,var(--bg1),var(--bg2));
        color: var(--text);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
    }

        body::before {
            content: "";
            position: fixed;
            width: min(520px,92vw);
            height: 380px;
            background: var(--card);
            border-radius: 22px;
            border: 1px solid var(--border);
            box-shadow: var(--shadow);
            backdrop-filter: blur(12px);
        }

        body::after {
            content: "Update User Password";
            position: fixed;
            top: calc(50% - 160px);
            left: 50%;
            transform: translateX(-50%);
            font-size: 22px;
            font-weight: 800;
        }

    .form-container {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    input[type="text"] {
        width: min(440px,88vw);
        padding: 14px;
        margin-top: 18px;
        border-radius: 14px;
        border: 1px solid var(--border);
        background: rgba(15,23,42,.75);
        color: var(--text);
    }

    button {
        width: min(440px,88vw);
        padding: 14px;
        margin-top: 20px;
        border-radius: 14px;
        border: none;
        font-weight: 700;
        cursor: pointer;
        color: #fff;
        background: linear-gradient(180deg,var(--primary),var(--primary-dark));
    }


    .home-btn {
        width: min(440px,88vw);
        padding: 14px;
        margin-top: 12px;
        border-radius: 14px;
        text-align: center;
        text-decoration: none;
        font-weight: 700;
        color: white;
        background: linear-gradient(180deg,#444,#777);
        display: block;
    }

        .home-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.3);
        }
</style>

<div class="form-container">
    <input type="text" @bind="userId" placeholder="Enter the userId that you want to delete" />
    <input type="text" @bind="NewPassword" placeholder="Enter the new password" />

    <button @onclick="UPDATE">Submit</button>

    <a href="/HomeRepice" class="home-btn">Back To Home</a>
</div>
<div class="bottom-text">
    @msg
</div>

