@page "/Delete"
@using MySql.Data.MySqlClient;

<style>
    :root {
        --bg1: #0f172a;
        --bg2: #020617;
        --card: rgba(15,23,42,.85);
        --border: rgba(148,163,184,.25);
        --text: #e2e8f0;
        --muted: rgba(226,232,240,.6);
        --danger: #ef4444;
        --danger-dark: #b91c1c;
        --shadow: 0 25px 70px rgba(0,0,0,.55);
    }

    html, body {
        height: 100%;
    }

    body {
        margin: 0;
        font-family: system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif;
        background: radial-gradient(1200px 600px at 20% 10%, rgba(239,68,68,.15), transparent 60%), radial-gradient(1000px 500px at 85% 20%, rgba(220,38,38,.12), transparent 55%), linear-gradient(180deg,var(--bg1),var(--bg2));
        color: var(--text);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
    }

    body::before {
        content: "";
        position: fixed;
        width: min(500px,90vw);
        height: 360px;
        background: var(--card);
        border-radius: 20px;
        border: 1px solid var(--border);
        box-shadow: var(--shadow);
        backdrop-filter: blur(12px);
    }

    body::after {
        content: "Delete User";
        position: fixed;
        top: calc(50% - 150px);
        left: 50%;
        transform: translateX(-50%);
        font-size: 22px;
        font-weight: 800;
    }

    .form-container {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    input[type="text"] {
        width: min(420px,85vw);
        padding: 14px;
        margin-top: 20px;
        border-radius: 14px;
        border: 1px solid var(--border);
        background: rgba(15,23,42,.75);
        color: var(--text);
    }

    button {
        width: min(420px,85vw);
        padding: 14px;
        margin-top: 16px;
        border-radius: 14px;
        border: none;
        font-weight: 700;
        cursor: pointer;
        color: #fff;
        background: linear-gradient(180deg,var(--danger),var(--danger-dark));
    }

    .home-btn {
        width: min(420px,85vw);
        padding: 14px;
        margin-top: 12px;
        border-radius: 14px;
        text-align: center;
        text-decoration: none;
        font-weight: 700;
        color: white;
        background: linear-gradient(180deg,#444,#777);
        display: block;
    }

    .home-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.3);
    }

    .bottom-text {
        margin-top: 15px;
        font-weight: bold;
        text-align: center;
    }

    .success {
        color: #22c55e;
    }

    .error {
        color: #ef4444;
    }
</style>

<div class="form-container">
    <input type="text" @bind="userId" placeholder="Enter the userId that you want to delete" />

    <button @onclick="DELETE">Submit</button>

    <a href="/HomeRepice" class="home-btn">Back To Home</a>
</div>

@code
{
    string userId;
    string msg = "";

    void DELETE()
    {
        MySqlConnection con = new MySqlConnection();
        con.ConnectionString = "server=localhost;user id=root;password=josh17rog;database=yakir_trading_app";
        con.Open();

        string Sql2 = $"DELETE FROM `yakir_trading_app`.`users` WHERE `userId` = '{userId}';";

        MySqlCommand cmd2 = new MySqlCommand();
        cmd2.Connection = con;
        cmd2.CommandText = Sql2;

        int x = cmd2.ExecuteNonQuery();

        if (x > 0)
        {
            msg = "User Deleted Successfully";
        }
        else
        {
            msg = "Error Deleting User";
        }

        con.Close();
    }
}