@page "/Login"
@using MySql.Data.MySqlClient
@inject NavigationManager nav

<style>
    body {
        margin: 0;
        padding: 0;
        font-family: Arial, sans-serif;
        background: linear-gradient(135deg, #fff8f0, #ffe8d6);
    }

    .register-page {
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 30px;
    }

    .register-card {
        width: 100%;
        max-width: 500px;
        background: white;
        border-radius: 25px;
        box-shadow: 0 15px 40px rgba(0,0,0,0.15);
        overflow: hidden;
    }

    .register-header {
        background: linear-gradient(135deg, #ff7b54, #ffb26b);
        color: white;
        text-align: center;
        padding: 35px 20px;
    }

        .register-header h1 {
            margin: 0;
            font-size: 36px;
        }

        .register-header p {
            margin-top: 10px;
            font-size: 16px;
            opacity: 0.95;
        }

    .register-body {
        padding: 35px 30px;
    }

    .form-group {
        margin-bottom: 20px;
    }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            font-size: 16px;
            font-weight: bold;
            color: #444;
        }

        .form-group input {
            width: 100%;
            padding: 14px;
            border: 2px solid #f3d2c1;
            border-radius: 14px;
            font-size: 15px;
            background-color: #fffaf7;
            box-sizing: border-box;
            transition: 0.3s;
        }

            .form-group input:focus {
                outline: none;
                border-color: #ff7b54;
                box-shadow: 0 0 10px rgba(255, 123, 84, 0.25);
                background-color: white;
            }

    .register-btn {
        width: 100%;
        padding: 15px;
        border: none;
        border-radius: 14px;
        background: linear-gradient(135deg, #ff7b54, #ff914d);
        color: white;
        font-size: 18px;
        font-weight: bold;
        cursor: pointer;
        transition: 0.3s;
        margin-top: 10px;
    }

        .register-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(255, 123, 84, 0.3);
        }

    .bottom-text {
        text-align: center;
        margin-top: 18px;
        color: #777;
        font-size: 14px;
    }

    .food-icon {
        font-size: 42px;
        margin-bottom: 10px;
    }
</style>

<div class="register-page">
    <div class="register-card">
        <div class="register-header">
            <div class="food-icon">🍳</div>
            <h1>Recipe Register</h1>
            <p>Create your account and start sharing delicious recipes</p>
        </div>

        <div class="register-body">
            <div class="form-group">
                <label>Username</label>
                <input type="text" @bind="userName" placeholder="Enter your username" />
            </div>

            <div class="form-group">
                <label>Password</label>
                <input type="password" @bind="userPasswordl" placeholder="Enter your password" />
            </div>

            <div class="form-group">
                <label>Email</label>
                <input type="email" @bind="userEmail" placeholder="Enter your email" />
            </div>

            <div class="form-group">
                <label>Nickname</label>
                <input type="text" @bind="usernickName" placeholder="Enter your nickname" />
            </div>

            <button class="register-btn" @onclick="login">Sign Up</button>

            <div class="bottom-text">
                Join our cooking community and discover amazing recipes
            </div>
            <div class="bottom-text">
                @msg
            </div>
        </div>
    </div>
</div>

@code
{
    string userName;
    string userPasswordl;
    string userEmail;
    string usernickName;
    string msg = "";

    void login()
    {
        MySqlConnection con = new MySqlConnection();
        con.ConnectionString = "server=localhost;user id=root;password=josh17rog;database=yakir_trading_app";
        con.Open();

        string sql = $"INSERT INTO `yakir_trading_app`.`users` (`userName`, `userPasswordl`, `userEmail`, `nickName`) VALUES ('{userName}', '{userPasswordl}', '{userEmail}', '{usernickName}');";
        MySqlCommand cmd = new MySqlCommand();
        cmd.Connection = con;
        cmd.CommandText = sql;

        int x = cmd.ExecuteNonQuery();
        if (x > 0)
        {
            nav.NavigateTo("/HomeRepice");
            msg = "User registered successfully!";
        }
        else
        {
            msg = "Registration failed. Please try again.";
        }

        con.Close();
    }
}