@page "/login"
@using MySql.Data.MySqlClient
@inject NavigationManager NavManager

<style>
    body {
        margin: 0;
        padding: 0;
        font-family: Arial, sans-serif;
        background: linear-gradient(135deg, #fff8f0, #ffe8d6);
    }

    .login-page {
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 30px;
    }

    .login-card {
        width: 100%;
        max-width: 500px;
        background: white;
        border-radius: 25px;
        box-shadow: 0 15px 40px rgba(0,0,0,0.15);
        overflow: hidden;
    }

    .login-header {
        background: linear-gradient(135deg, #ff7b54, #ffb26b);
        color: white;
        text-align: center;
        padding: 35px 20px;
    }

        .login-header h3 {
            margin: 0;
            font-size: 32px;
        }

    .login-body {
        padding: 35px 30px;
    }

    .form-group {
        margin-bottom: 20px;
    }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            font-size: 16px;
            font-weight: bold;
            color: #444;
        }

        .form-group input {
            width: 100%;
            padding: 14px;
            border: 2px solid #f3d2c1;
            border-radius: 14px;
            font-size: 15px;
            background-color: #fffaf7;
            box-sizing: border-box;
        }

    .login-btn {
        width: 100%;
        padding: 15px;
        border: none;
        border-radius: 14px;
        background: linear-gradient(135deg, #ff7b54, #ff914d);
        color: white;
        font-size: 18px;
        font-weight: bold;
        cursor: pointer;
    }

    .home-btn {
        display: block;
        width: 100%;
        margin-top: 15px;
        padding: 15px;
        text-align: center;
        text-decoration: none;
        border-radius: 14px;
        background: linear-gradient(135deg, #444, #777);
        color: white;
        font-size: 18px;
        font-weight: bold;
        box-sizing: border-box;
    }

    .error-text {
        text-align: center;
        color: red;
        font-weight: bold;
        margin-top: 18px;
    }
</style>

<div class="login-page">
    <div class="login-card">
        <div class="login-header">
            <h3>דף התחברות (דידקטי)</h3>
        </div>

        <div class="login-body">
            <div class="form-group">
                <label>שם משתמש:</label>
                <input type="text" @bind="inputUser" />
            </div>

            <div class="form-group">
                <label>סיסמה:</label>
                <input type="password" @bind="inputPass" />
            </div>

            <button class="login-btn" @onclick="CheckLogin">התחבר</button>

            <a href="/HomeRepice" class="home-btn">Back To Home</a>

            <p class="error-text">@errorMessage</p>
        </div>
    </div>
</div>

@code
{
    private string inputUser;
    private string inputPass;
    private string errorMessage;
    private MySqlDataReader r;

    private void CheckLogin()
    {
        // הגדרת חיבור
        MySqlConnection con = new MySqlConnection();
        con.ConnectionString = "server=localhost;user id=root;password=josh17rog;database=yakir_trading_app;";
        con.Open();

        // שאילתה לקבלת כל המשתמשים
        MySqlCommand cmd = new MySqlCommand();
        cmd.Connection = con;
        cmd.CommandText = "SELECT * FROM yakir_trading_app.users;";

        r = cmd.ExecuteReader();

        bool isAuthenticated = false;

        // מעבר על כל המשתמשים בלולאת while
        while (r.Read())
        {
            string dbName = r["Username"].ToString();
            string dbPass = r["UserPasswordl"].ToString();

            // בדיקה האם הקלט תואם לאחד המשתמשים בטבלה
            if (dbName == inputUser && dbPass == inputPass)
            {
                isAuthenticated = true;
                break; // מצאנו משתמש, אפשר לצאת מהלולאה
            }
        }

        r.Close();
        con.Close();

        if (isAuthenticated)
        {
            // העברה לדף אחר ל לא שימוש ב-Session או הגנה
            NavManager.NavigateTo("/HomeRepice");
        }
        else
        {
            errorMessage = "שם משתמש או סיסמה שגויים.";
        }
    }
}